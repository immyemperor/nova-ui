{
  "name": "nova-ui-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "dev:vite": "pnpm --filter playground-vite dev",
    "dev:next": "pnpm --filter playground-next dev",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "rename-scope": "node scripts/rename-scope.mjs",
    "check:names": "node scripts/check-prop-names.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "typescript": "^5.6.0",
    "playwright": "^1.50.0"
  }
}
