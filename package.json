{
  "name": "kvui-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "clean": "pnpm -r --filter \"./packages/*\" exec rm -rf dist loader .stencil",
    "publish:packages": "pnpm -r --filter \"./packages/*\" publish --access public --no-git-checks",
    "dev:vite": "pnpm --filter playground-vite dev",
    "dev:next": "pnpm --filter playground-next dev",
    "dev:react": "pnpm --filter playground-react dev",
    "dev:angular": "pnpm --filter playground-angular start",
    "playgrounds:check": "node scripts/playground-check.mjs",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/release.mjs all",
    "rename-scope": "node scripts/rename-scope.mjs",
    "check:names": "node scripts/check-prop-names.mjs",
    "verify": "pnpm -r test && pnpm check:names && pnpm docs:check && pnpm playgrounds:check",
    "docs": "node packages/core/scripts/generate-docs.mjs && node packages/vue/scripts/generate.mjs && node scripts/build-llms.mjs",
    "docs:agents": "node scripts/build-llms.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "node scripts/release.mjs pack",
    "release:publish": "node scripts/release.mjs publish",
    "release:dry-run": "node scripts/release.mjs all --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^26.6.6",
    "playwright": "^1.50.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@kvui/core": "^0.1.0"
  }
}
