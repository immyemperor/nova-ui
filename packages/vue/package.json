{
  "name": "@omni/vue",
  "version": "0.1.0",
  "description": "Vue 3 wrappers for Nova UI web components (generated from the component manifest).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "test": "node --test test/vue-wrappers.test.mjs",
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": ">=3.3.0",
    "@omni/core": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vue": "^3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immyemperor/nova-ui.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/immyemperor/nova-ui#readme",
  "bugs": {
    "url": "https://github.com/immyemperor/nova-ui/issues"
  }
}
