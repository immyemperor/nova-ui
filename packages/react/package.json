{
  "name": "@omni/react",
  "version": "0.1.0",
  "description": "React and Next.js bindings for Nova UI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "require": "./dist/editor.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@omni/core": "workspace:^",
    "@stencil/react-output-target": "^1.8.1"
  },
  "peerDependencies": {
    "@omni/editor": "^0.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@omni/editor": "workspace:^",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@omni/editor": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immyemperor/nova-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/immyemperor/nova-ui#readme",
  "bugs": {
    "url": "https://github.com/immyemperor/nova-ui/issues"
  }
}
